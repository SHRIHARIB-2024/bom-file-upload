{
  "_version": "1.65.0",
  "sap.app": {
    "id": "upload.bom.app",
    "type": "application",
    "title": "Upload Bill of Material",
    "description": "Search material BOMs and upload additional line items from CSV.",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "bomService": {
        "uri": "/odata/v4/bom/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "uploadBillOfMaterial": {
          "semanticObject": "BillOfMaterial",
          "action": "upload",
          "title": "Upload Bill of Material",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.ui.table": {}
      }
    },
    "models": {
      "": {
        "dataSource": "bomService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "synchronizationMode": "None"
        }
      },
      "view": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "rootView": {
      "viewName": "upload.bom.app.view.App",
      "type": "XML",
      "id": "app"
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "upload-bill-of-material"
  }
}
