<mvc:View
  controllerName="upload.bom.app.controller.App"
  displayBlock="true"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.ui.layout.form">
  <App>
    <Page title="Upload Bill of Material" showNavButton="false">
      <content>
        <VBox class="sapUiMediumMargin">
          <Panel headerText="Material Selection" expandable="false">
            <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="4">
              <Label text="Material" required="true" />
              <Input value="{view>/selection/material}" showValueHelp="true" valueHelpRequest=".onMaterialHelp" placeholder="3000000814" />
              <Label text="Plant" required="true" />
              <Input value="{view>/selection/plant}" placeholder="1001" maxLength="4" />
              <Label text="BOM Usage" required="true" />
              <Input value="{view>/selection/bomUsage}" placeholder="1" maxLength="1" />
              <Label text="Alternative BOM" />
              <Input value="{view>/selection/alternativeBom}" placeholder="01" maxLength="2" />
              <Label text="Valid From" />
              <DatePicker value="{view>/selection/validFrom}" displayFormat="medium" valueFormat="yyyy-MM-dd" />
              <Label text="Revision Level" />
              <Input value="{view>/selection/revisionLevel}" maxLength="2" />
            </f:SimpleForm>
            <Toolbar class="sapUiTinyMarginTop">
              <ToolbarSpacer />
              <Button text="Load BOM" type="Emphasized" icon="sap-icon://search" press=".onLoadBom" />
            </Toolbar>
          </Panel>

          <Panel headerText="BOM Header" class="sapUiMediumMarginTop" visible="{view>/headerVisible}">
            <ObjectHeader
              title="{view>/header/material}"
              number="{view>/header/plant}"
              numberUnit="{view>/header/plantName}"
              intro="{view>/header/materialText}">
              <attributes>
                <ObjectAttribute title="BOM Usage" text="{view>/header/bomUsage}" />
                <ObjectAttribute title="Alternative BOM" text="{view>/header/alternativeBom}" />
                <ObjectAttribute title="Valid From" text="{view>/header/validFrom}" />
              </attributes>
            </ObjectHeader>
          </Panel>

          <Panel headerText="BOM Line Items" class="sapUiMediumMarginTop" visible="{view>/headerVisible}">
            <Toolbar>
              <Title text="Components" level="H3" />
              <ToolbarSpacer />
              <Text text="{view>/itemsCount} item(s)" />
            </Toolbar>
            <Table items="{view>/items}" growing="true" growingThreshold="20" class="bomTable">
              <columns>
                <Column width="5rem"><Text text="Item" /></Column>
                <Column><Text text="Component" /></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Description" /></Column>
                <Column hAlign="End" width="7rem"><Text text="Quantity" /></Column>
                <Column width="5rem"><Text text="Unit" /></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Valid From" /></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Source" /></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{view>itemNo}" />
                    <Text text="{view>component}" />
                    <Text text="{view>componentDescription}" />
                    <ObjectNumber number="{view>quantity}" />
                    <Text text="{view>unit}" />
                    <Text text="{view>validFrom}" />
                    <ObjectStatus text="{view>source}" state="{= ${view>source} === 'Uploaded' ? 'Success' : 'Information' }" />
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </Panel>

          <Panel headerText="Upload Additional Components" class="sapUiMediumMarginTop" visible="{view>/headerVisible}">
            <VBox>
              <Text text="CSV columns: component,description,quantity,unit,validFrom,validTo,changeNumber,sortString,itemId" class="sapUiTinyMarginBottom" />
              <HBox alignItems="Center" renderType="Bare">
                <Input value="{view>/fileName}" editable="false" placeholder="Choose CSV file" width="24rem" />
                <Button icon="sap-icon://attachment" tooltip="Choose CSV file" press=".onChooseFile" class="sapUiTinyMarginBegin" />
                <Button text="Upload" icon="sap-icon://upload" type="Emphasized" press=".onUpload" class="sapUiTinyMarginBegin" enabled="{view>/canUpload}" />
                <Button text="Refresh" icon="sap-icon://refresh" press=".onLoadBom" class="sapUiTinyMarginBegin" />
              </HBox>
              <core:HTML content="&lt;input id='bomCsvFile' type='file' accept='.csv,text/csv' style='display:none' /&gt;" />
            </VBox>
          </Panel>
        </VBox>
      </content>
      <footer>
        <OverflowToolbar visible="{view>/headerVisible}">
          <ToolbarSpacer />
          <Button text="Save BOM" type="Emphasized" icon="sap-icon://save" press=".onSave" />
          <Button text="Cancel" icon="sap-icon://decline" press=".onCancel" />
        </OverflowToolbar>
      </footer>
    </Page>
  </App>
</mvc:View>
