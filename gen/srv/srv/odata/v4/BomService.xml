<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Alias="UI" Namespace="com.sap.vocabularies.UI.v1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="BomService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="BomHeaders" EntityType="BomService.BomHeaders">
          <NavigationPropertyBinding Path="items" Target="BomItems"/>
        </EntitySet>
        <EntitySet Name="BomItems" EntityType="BomService.BomItems">
          <NavigationPropertyBinding Path="parent" Target="BomHeaders"/>
        </EntitySet>
        <ActionImport Name="uploadBom" Action="BomService.uploadBom"/>
      </EntityContainer>
      <EntityType Name="BomHeaders">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="material" Type="Edm.String" MaxLength="40"/>
        <Property Name="materialText" Type="Edm.String" MaxLength="120"/>
        <Property Name="plant" Type="Edm.String" MaxLength="4"/>
        <Property Name="plantName" Type="Edm.String" MaxLength="80"/>
        <Property Name="bomUsage" Type="Edm.String" MaxLength="1"/>
        <Property Name="alternativeBom" Type="Edm.String" MaxLength="2"/>
        <Property Name="validFrom" Type="Edm.Date"/>
        <Property Name="revisionLevel" Type="Edm.String" MaxLength="2"/>
        <Property Name="changeNumber" Type="Edm.String" MaxLength="12"/>
        <NavigationProperty Name="items" Type="Collection(BomService.BomItems)" Partner="parent">
          <OnDelete Action="Cascade"/>
        </NavigationProperty>
      </EntityType>
      <EntityType Name="BomItems">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <NavigationProperty Name="parent" Type="BomService.BomHeaders" Partner="items">
          <ReferentialConstraint Property="parent_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="parent_ID" Type="Edm.Guid"/>
        <Property Name="itemNo" Type="Edm.String" MaxLength="4"/>
        <Property Name="component" Type="Edm.String" MaxLength="40"/>
        <Property Name="componentDescription" Type="Edm.String" MaxLength="120"/>
        <Property Name="quantity" Type="Edm.Decimal" Precision="13" Scale="3"/>
        <Property Name="unit" Type="Edm.String" MaxLength="3"/>
        <Property Name="validFrom" Type="Edm.Date"/>
        <Property Name="validTo" Type="Edm.Date"/>
        <Property Name="changeNumber" Type="Edm.String" MaxLength="12"/>
        <Property Name="sortString" Type="Edm.String" MaxLength="20"/>
        <Property Name="itemId" Type="Edm.String" MaxLength="12"/>
        <Property Name="source" Type="Edm.String" MaxLength="12"/>
      </EntityType>
      <ComplexType Name="UploadResult">
        <Property Name="success" Type="Edm.Boolean"/>
        <Property Name="message" Type="Edm.String" MaxLength="255"/>
        <Property Name="inserted" Type="Edm.Int32"/>
      </ComplexType>
      <Action Name="uploadBom" IsBound="false">
        <Parameter Name="material" Type="Edm.String" MaxLength="40"/>
        <Parameter Name="plant" Type="Edm.String" MaxLength="4"/>
        <Parameter Name="bomUsage" Type="Edm.String" MaxLength="1"/>
        <Parameter Name="alternativeBom" Type="Edm.String" MaxLength="2"/>
        <Parameter Name="fileName" Type="Edm.String" MaxLength="120"/>
        <Parameter Name="csvContent" Type="Edm.String"/>
        <ReturnType Type="BomService.UploadResult"/>
      </Action>
      <Annotations Target="BomService.BomHeaders/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="BomService.BomHeaders/createdAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedAt}"/>
      </Annotations>
      <Annotations Target="BomService.BomHeaders/createdBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedBy}"/>
      </Annotations>
      <Annotations Target="BomService.BomHeaders/modifiedAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedAt}"/>
      </Annotations>
      <Annotations Target="BomService.BomHeaders/modifiedBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedBy}"/>
      </Annotations>
      <Annotations Target="BomService.BomItems/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="BomService.BomItems/createdAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedAt}"/>
      </Annotations>
      <Annotations Target="BomService.BomItems/createdBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedBy}"/>
      </Annotations>
      <Annotations Target="BomService.BomItems/modifiedAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedAt}"/>
      </Annotations>
      <Annotations Target="BomService.BomItems/modifiedBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedBy}"/>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>